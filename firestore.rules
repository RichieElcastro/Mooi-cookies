rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ahmad.23188@mhs.unesa.ac.id' ||
        get(/databases/database/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Affiliates collection (admin manages, public can read active affiliates for checkout drop points)
    match /affiliates/{affiliateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Menu and batch schedules
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /batchSchedules/{batchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer loyalty & vouchers
    match /loyalty/{phone} {
      allow read, write: if true;
    }

    match /vouchers/{voucherId} {
      allow read, write: if true;
    }
  }
}
